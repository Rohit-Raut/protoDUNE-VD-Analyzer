#include "services_protodunevd.fcl"

process_name: TriggerAnalysis

services: {
    TFileService: {
        fileName: "/pnfs/dune/scratch/users/rraut/hist/test_pdvdData.root"
	closeFileFast: false
    }
    TimeTracker:        @local::dune_time_tracker
    MemoryTracker:      @local::dune_memory_tracker
    RandomNumberGenerator: {}
    FileCatalogMetadata: @local::art_file_catalog_mc
    @table::protodunevd_simulation_services
}

# Fix for the JSON parsing error - update PDS channel mapping
# I got this issue resolved using slack
services.DAPHNEChannelMapService.FileName: "PDVD_PDS_Mapping_v07082025.json"
services.WireReadout.PDMapTool.MappingFile: "PDVD_PDS_Mapping_v07082025.json"

source: {
    module_type: RootInput
    maxEvents: -1
    fileNames: []
