physics: {
    analyzers: {
        triggerAnalysis: {
            module_type: "TriggerAnalysis"
            TPLabel:     "triggerrawdecoder:daq"
            TALabel:     "triggerrawdecoder:daq"
        }
    }
    
    analysis_path: [triggerAnalysis]
    end_paths:     [analysis_path]
}
